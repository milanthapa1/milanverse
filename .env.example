# ============================================================
# MilanVerse environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# ============================================================

# ── Neon (serverless Postgres) ───────────────────────────────
# POOLED connection string (pgBouncer) → used at RUNTIME by the app + Prisma client.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require"
# DIRECT (non-pooled) connection string → used by `prisma migrate` / `prisma db push`.
# Migrations must never go through the pooler. See prisma7.config.ts.
DIRECT_URL="postgresql://USER:DIRECT_PASSWORD@ep-xxxxx.region.aws.neon.tech:5432/neondb?sslmode=require"

# ── Auth.js (next-auth v5) ───────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the deployed app (used for OAuth redirects)
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── App ──────────────────────────────────────────────────────
# Canonical URL used for metadata, OG images, robots and sitemap.
# Server-only: do NOT add the NEXT_PUBLIC_ prefix (it would ship to the browser).
# No trailing slash.
APP_URL="http://localhost:3000"

# ── Optional feature flags ───────────────────────────────────
# Cloudinary avatar upload — NOT part of the MVP, scaffolded behind this flag.
FEATURE_AVATAR_UPLOAD="false"
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
